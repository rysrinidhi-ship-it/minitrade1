# Copy to .env and adjust. Every setting can also be a real environment variable.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/minitrade
# Comma separated list of browser origins allowed to call the API ("*" = any)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# The assignment has one demo user and no login: this is the user id the API acts as
DEMO_USER_ID=1
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
PORT=8000
